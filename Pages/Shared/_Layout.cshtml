<!DOCTYPE html>
<html lang="en">
@RenderSection("Styles", required: false)

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Proyecto</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Proyecto.styles.css" asp-append-version="true" />
</head>

<body>
    <header>
        <nav class="navbar">
            <div class="logo">
                <a asp-page="/Index">Biblioteca</a>
            </div>

            <div class="nav-links">
                <a asp-page="/Index">Inicio</a>
                <a asp-page="/Libros/Catalogo">Catálogo</a>

                @if (Context.Session.GetString("AdminId") != null)
                {
                    <div class="usuario-menu">
                        <span class="nav-usuario">🔑 @Context.Session.GetString("AdminNombre")</span>
                        <a asp-page="/Auth/LogoutAdmin">Cerrar sesión</a>
                    </div>

                    <a asp-page="/Admin/PanelAdmin">Panel administrativo</a>
                }
                else if (Context.Session.GetString("SocioId") != null)
                {
                    <span class="nav-usuario">👤 @Context.Session.GetString("SocioNombre")</span>
                    <a asp-page="/Auth/Logout">Cerrar sesión</a>
                }
                else
                {
                    <a asp-page="/Auth/Login">Login</a>
                    <a asp-page="/Auth/Registro">Registro</a>
                    <a asp-page="/Auth/LoginAdmin">Panel administrativo</a>
                }
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Proyecto - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
