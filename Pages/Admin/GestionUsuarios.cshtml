@page
@model Proyecto.Pages.Admin.GestionUsuariosModel
@{
    ViewData["Title"] = "Gestión de usuarios";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Admin/gestionUsuarios.css" />
}

<section class="gestion-usuarios">
    <div class="encabezado">
        <h1>Gestión de usuarios</h1>
        <button class="btn-agregar" data-bs-toggle="modal" data-bs-target="#modalAgregarUsuario">
            Agregar usuario
        </button>
    </div>

    <form method="get" class="busqueda">

        <input type="text" name="Buscar" value="@Model.Buscar"
               placeholder="Buscar usuario por nombre, folio, correo o teléfono">

        <button type="submit">
            Buscar
        </button>

    </form>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger mt-3">
            @TempData["Error"]
        </div>
    }

    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success mt-3">
            @TempData["Exito"]
        </div>
    }

    <table class="tabla-usuarios">
        <thead>
            <tr>
                <th>No. Socio</th>
                <th>Nombre</th>
                <th>Correo</th>
                <th>Dirección</th>
                <th>Credencial</th>
                <th>Teléfono</th>
                <th>Acciones</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var socio in Model.Socios)
            {
                <tr>
                    <td>@socio.NumSocio</td>
                    <td>@socio.NombCompleto</td>
                    <td>@socio.CorreoElectronico</td>
                    <td>@socio.Direccion</td>
                    <td>@socio.MatriculaCredencialNavigation?.Numero</td>
                    <td>@string.Join(", ", socio.Telefonos.Select(t => t.Numero))</td>

                    <td class="acciones">
                        <button class="editar" data-bs-toggle="modal" data-bs-target="#modalEditarUsuario"
                                data-id="@socio.NumSocio" data-nombre="@socio.NombCompleto"
                                data-correo="@socio.CorreoElectronico" data-direccion="@socio.Direccion"
                                data-telefono="@socio.Telefonos.FirstOrDefault()?.Numero"
                                data-credencial="@socio.MatriculaCredencialNavigation?.Numero"
                                data-contrasena="@socio.Contrasena">
                            Editar
                        </button>
                        <button class="eliminar" data-bs-toggle="modal" data-bs-target="#modalEliminarUsuario"
                                data-id="@socio.NumSocio" data-nombre="@socio.NombCompleto">
                            Eliminar
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</section>

<partial name="~/Pages/Modales/_ModalAgregarUsuario.cshtml" model="Model" />

<partial name="~/Pages/Modales/_ModalEditarUsuario.cshtml" model="Model" />

<partial name="~/Pages/Modales/_ModalEliminarUsuario.cshtml" model="Model" />