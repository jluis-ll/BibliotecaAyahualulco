@page
@model Proyecto.Pages.Admin.ReservasModel
@{
    ViewData["Title"] = "Reservas";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Admin/reservas.css" />
}

<section class="reservas">
    <div class="encabezado">
        <h1>Reservas</h1>
        <button class="btn-agregar" data-bs-toggle="modal" data-bs-target="#modalAgregarReserva">
            Agregar reserva
        </button>
    </div>

    <form method="get" class="busqueda">

        <input type="text" name="Buscar" value="@Model.Buscar" placeholder="Buscar por usuario o libro">

        <button type="submit">
            Buscar
        </button>

    </form>

    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success mt-3">
            @TempData["Exito"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger mt-3">
            @TempData["Error"]
        </div>
    }

    <table class="tabla-reservas">
        <thead>
            <tr>
                <th>ID Reserva</th>
                <th>Usuario</th>
                <th>Libro</th>
                <th>Fecha reserva</th>
                <th>Acciones</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var reserva in Model.Reservas)
            {
                <tr>
                    <td>@reserva.IdReserva</td>
                    <td>@reserva.NumSocioNavigation.NombCompleto</td>
                    <td>@reserva.FolioLibroNavigation.Nombre</td>
                    <td>@reserva.FechaReserva.ToString("dd/MM/yyyy")</td>
                    <td class="accciones">
                        <button type="button" class="editar" data-bs-toggle="modal" data-bs-target="#modalEditarReserva"
                                data-id="@reserva.IdReserva" data-libro="@reserva.FolioLibro">
                            Editar
                        </button>
                        <button type="button" class="eliminar" data-bs-toggle="modal" data-bs-target="#modalEliminarReserva"
                                data-id="@reserva.IdReserva" data-usuario="@reserva.NumSocioNavigation.NombCompleto"
                                data-libro="@reserva.FolioLibroNavigation.Nombre">
                            Eliminar
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</section>

<partial name="~/Pages/Modales/_ModalAgregarReserva.cshtml" model="Model" />

<partial name="~/Pages/Modales/_ModalEliminarReserva.cshtml" model="Model" />

<partial name="~/Pages/Modales/_ModalEditarReserva.cshtml" model="Model" />