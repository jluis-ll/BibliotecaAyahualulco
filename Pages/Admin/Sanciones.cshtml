@page
@model Proyecto.Pages.Admin.SancionesModel
@{
    ViewData["Title"] = "Sanciones";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Admin/sanciones.css" />
}

<section class="sanciones">
    <div class="encabezado">
        <h1>Sanciones</h1>
    </div>
    <form method="get" class="busqueda">

        <input type="text" name="Buscar" value="@Model.Buscar" placeholder="Buscar usuario, folio, libro o descripción">

        <button type="submit">
            Buscar
        </button>

    </form>
    <table class="tabla-sanciones">
        <thead>
            <tr>
                <th>Folio</th>
                <th>Usuario</th>
                <th>Libro</th>
                <th>Descripción</th>
                <th>Monto</th>
                <th>Límite de pago</th>
                <th>Estado préstamo</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var sancion in Model.Sanciones)
            {
                <tr>
                    <td>@sancion.Folio</td>
                    <td>@sancion.NumPrestamoNavigation.NumSocioNavigation.NombCompleto</td>
                    <td>@sancion.NumPrestamoNavigation.FolioLibroNavigation.Nombre</td>
                    <td>@sancion.Descripcion</td>
                    <td>$@sancion.MontoSancion</td>
                    <td>@sancion.LimitePago.ToString("dd/MM/yyyy")</td>
                    <td>@sancion.NumPrestamoNavigation.EstatusPrestamo</td>
                </tr>
            }
        </tbody>
    </table>
</section>