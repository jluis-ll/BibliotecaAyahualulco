@page
@model Proyecto.Pages.Admin.PrestamosModel
@{
    ViewData["Title"] = "Préstamos";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Admin/prestamos.css" />
}

<section class="prestamos">

    <div class="encabezado">
        <h1>Préstamos</h1>
    </div>

    <form method="post" class="formulario-prestamo">

        <div class="campo">

            <label>Usuario</label>

            <select name="NumSocio" required>

                <option value="">
                    Selecciona un usuario
                </option>

                @foreach (var socio in Model.Socios)
                {
                    <option value="@socio.NumSocio">
                        @socio.NombCompleto
                    </option>
                }

            </select>

        </div>

        <div class="campo">

            <label>Libro</label>

            <select name="FolioLibro" required>

                <option value="">
                    Selecciona un libro
                </option>

                @foreach (var libro in Model.Libros)
                {
                    <option value="@libro.FolioLibro">
                        @libro.Nombre - Copias: @libro.NumeroCopias
                    </option>
                }

            </select>

        </div>

        <div class="campo">

            <label>Bibliotecario</label>

            <select name="IdBibliotecario">

                <option value="">
                    Selecciona un bibliotecario
                </option>

                @foreach (var b in Model.Bibliotecarios)
                {
                    <option value="@b.IdBibliotecario">
                        @b.Nombre
                    </option>
                }

            </select>

        </div>

        <div class="campo">

            <label>Fecha de devolución</label>

            <input type="date" name="FechaEntrega" required>

        </div>

        <button type="submit" class="btn-registrar">

            Registrar préstamo

        </button>

    </form>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger mt-3">
            @TempData["Error"]
        </div>
    }

    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success mt-3">
            @TempData["Exito"]
        </div>
    }

    <div class="tabla-contenedor">

        <table class="tabla-prestamos">

            <thead>
                <tr>
                    <th>No. Préstamo</th>
                    <th>Usuario</th>
                    <th>Libro</th>
                    <th>Fecha préstamo</th>
                    <th>Fecha entrega</th>
                    <th>Estado</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var prestamo in Model.Prestamos)
                {
                    <tr>
                        <td>@prestamo.NumPrestamo</td>
                        <td>@prestamo.NumSocioNavigation.NombCompleto</td>
                        <td>@prestamo.FolioLibroNavigation.Nombre</td>
                        <td>@prestamo.FechaInicio.ToString("dd/MM/yyyy")</td>
                        <td>@prestamo.FechaEntrega.ToString("dd/MM/yyyy")</td>
                        <td>@prestamo.EstatusPrestamo</td>
                    </tr>
                }
            </tbody>

        </table>

    </div>

</section>