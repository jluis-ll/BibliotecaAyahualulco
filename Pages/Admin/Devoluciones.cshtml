@page
@model Proyecto.Pages.Admin.DevolucionesModel
@{
    ViewData["Title"] = "Devoluciones";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Admin/devoluciones.css" />
}

<section class="devoluciones">
    <div class="encabezado">
        <h1>Devoluciones</h1>
    </div>

    <form method="get" class="busqueda">

        <input type="text" name="Buscar" value="@Model.Buscar" placeholder="Buscar préstamo, usuario o libro">

        <button type="submit">
            Buscar
        </button>

    </form>

    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success mt-3">
            @TempData["Exito"]
        </div>
    }

    <table class="tabla-devoluciones">
        <thead>
            <tr>
                <th>No. Préstamo</th>
                <th>Usuario</th>
                <th>Libro</th>
                <th>Fecha entrega</th>
                <th>Estado</th>
                <th>Acción</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var prestamo in Model.Prestamos)
            {
                <tr>
                    <td>@prestamo.NumPrestamo</td>
                    <td>@prestamo.NumSocioNavigation.NombCompleto</td>
                    <td>@prestamo.FolioLibroNavigation.Nombre</td>
                    <td>
                        @(prestamo.FechaEntrega.HasValue
                            ? prestamo.FechaEntrega.Value.ToShortDateString()
                            : "-")
                    </td>
                    <td>@prestamo.EstatusPrestamo</td>
                    <td>
                        <button type="button" class="btn-devolver" data-bs-toggle="modal"
                                data-bs-target="#modalRegistrarDevolucion" data-id="@prestamo.NumPrestamo"
                                data-usuario="@prestamo.NumSocioNavigation.NombCompleto"
                                data-libro="@prestamo.FolioLibroNavigation.Nombre">

                            Registrar devolución

                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</section>

<partial name="~/Pages/Modales/_ModalRegistrarDevolucion.cshtml" model="Model" />