@page
@model MyApp.Namespace.DevolucionesModel
@{
    ViewData["Title"] = "Devoluciones";
}

@section Styles{
    <link rel="stylesheet" href="~/css/Admin/devoluciones.css" />
}

<section class="devoluciones">
    <div class="encabezado">
        <h1>Devoluciones</h1>
    </div>

    <div class="busqueda">
        <input type="text" placeholder="Buscar préstamo por folio o usuario">
        <button>Buscar</button>
    </div>

    <table class="tabla-devoluciones">
        <thead>
            <tr>
                <th>Folio</th>
                <th>Usuario</th>
                <th>Libro</th>
                <th>Fecha devolución</th>
                <th>Estado</th>
                <th>Acción</th>
            </tr>
        </thead>

        <tbody>
            <tr>
                <td>FOL-001</td>
                <td>Carlos Hernández</td>
                <td>El Principito</td>
                <td>04/06/2026</td>
                <td>Activo</td>
                <td>
                    <button class="btn-devolver">Registrar devolución</button>
                </td>
            </tr>

            <tr>
                <td>FOL-002</td>
                <td>Ana López</td>
                <td>Don Quijote</td>
                <td>27/05/2026</td>
                <td>Atrasado</td>
                <td>
                    <button class="btn-devolver">Registrar devolución</button>
                </td>
            </tr>
        </tbody>
    </table>
</section>