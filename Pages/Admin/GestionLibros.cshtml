@page
@model Proyecto.Pages.Admin.GestionLibrosModel
@{
    ViewData["Title"] = "Gestión de libros";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Admin/gestionLibros.css" />
}

<section class="gestion-libros">

    <div class="encabezado">
        <h1>Gestión de libros</h1>
        <button class="btn-agregar" data-bs-toggle="modal" data-bs-target="#modalAgregarLibro">
            Agregar libro
        </button>
    </div>

    <form method="get" class="busqueda">

        <input type="text" name="Buscar" value="@Model.Buscar" placeholder="Buscar libro por título, ISBN o autor">

        <button type="submit">
            Buscar
        </button>

    </form>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success">
            @TempData["Exito"]
        </div>
    }

    <table class="tabla-libros">
        <thead>
            <tr>
                <th>Folio</th>
                <th>Título</th>
                <th>Autor</th>
                <th>Editorial</th>
                <th>Copias</th>
                <th>Acciones</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var libro in Model.Libros)
            {
                <tr>
                    <td>@libro.FolioLibro</td>
                    <td>@libro.Nombre</td>
                    <td>@string.Join(", ", libro.IdAutors.Select(a => a.Nombre))</td>
                    <td>@libro.IdEditorialNavigation?.Nombre</td>
                    <td>@libro.NumeroCopias</td>

                    <td class="acciones">
                        <button class="editar" data-bs-toggle="modal" data-bs-target="#modalEditarLibro"
                                data-id="@libro.FolioLibro" data-nombre="@libro.Nombre" data-isbn="@libro.Isbn"
                                data-copias="@libro.NumeroCopias" data-condicion="@libro.CondicionLibro"
                                data-pasillo="@libro.IdUbicacionNavigation?.IdPasillo"
                                data-piso="@libro.IdUbicacionNavigation?.Piso">
                            Editar
                        </button>
                        <button class="eliminar" data-bs-toggle="modal" data-bs-target="#modalEliminarLibro"
                                data-id="@libro.FolioLibro" data-nombre="@libro.Nombre">

                            Eliminar

                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

</section>

<partial name="~/Pages/Modales/_ModalAgregarLibro.cshtml" model="Model" />

<partial name="~/Pages/Modales/_ModalEditarLibro.cshtml" model="Model" />

<partial name="~/Pages/Modales/_ModalEliminarLibro.cshtml" model="Model" />