@page
@model IndexModel
@{
    ViewData["Title"] = "Inicio";
}

@section Styles {
    <link rel="stylesheet" href="~/css/inicio.css" />
}

<section class="inicio">
    <div class="bienvenida">
        <h1>Biblioteca Municipal de Ayahualulco</h1>
        <p>Consulta libros, revisa disponibilidad y gestiona préstamos de manera sencilla.</p>
    </div>

    <form method="get" asp-page="/Libros/Catalogo" class="busqueda">

        <input type="text" name="Buscar" placeholder="Buscar libro por título, autor o categoría">

        <button type="submit">
            Buscar
        </button>

    </form>

    <div class="accesos">
        <a asp-page="/Libros/Catalogo" class="boton">Catálogo</a>

        @if (HttpContext.Session.GetString("AdminId") != null)
        {
            <a asp-page="/Admin/PanelAdmin" class="boton">Panel administrativo</a>
        }
        else if (HttpContext.Session.GetString("SocioId") == null)
        {
            <a asp-page="/Auth/Login" class="boton">Iniciar sesión</a>
            <a asp-page="/Auth/Registro" class="boton">Registro</a>
            <a asp-page="/Auth/LoginAdmin" class="boton">Panel administrativo</a>
        }
    </div>

    <section class="populares">
        <h2>Libros populares</h2>

        <div class="contenedor-libros">
            @foreach (var item in Model.LibrosPopulares)
            {
                <div class="libro">
                    <img src="~/img/libro1.jpg" alt="Portada del libro">

                    <h3>@item.Libro.Nombre</h3>

                    <p>
                        Popularidad: @item.TotalMovimientos
                    </p>

                    <a asp-page="/Libros/DetalleLibro" asp-route-id="@item.Libro.FolioLibro" class="boton-secundario">
                        Ver detalle
                    </a>
                </div>
            }
        </div>
    </section>
</section>