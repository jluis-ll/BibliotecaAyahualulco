<div class="modal fade" id="modalEliminarUsuario" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Eliminar usuario</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <form method="post" asp-page-handler="Eliminar">

                    <input type="hidden" id="eliminarIdUsuario" name="NumSocio">

                    <p>¿Seguro que deseas eliminar al usuario?</p>
                    <strong id="eliminarNombreUsuario"></strong>

                    <div class="modal-footer px-0 pb-0">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                            Cancelar
                        </button>

                        <button type="submit" class="btn btn-danger">
                            Eliminar
                        </button>
                    </div>

                </form>
            </div>

        </div>
    </div>
</div>

<script>
    const modalEliminarUsuario = document.getElementById('modalEliminarUsuario');

    modalEliminarUsuario.addEventListener('show.bs.modal', function (event) {
        const boton = event.relatedTarget;

        document.getElementById('eliminarIdUsuario').value =
            boton.getAttribute('data-id');

        document.getElementById('eliminarNombreUsuario').textContent =
            boton.getAttribute('data-nombre');
    });
</script>