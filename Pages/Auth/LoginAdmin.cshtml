@page
@model MyApp.Namespace.LoginAdminModel
@{
    ViewData["Title"] = "Acceso Bibliotecario";
}

@section Styles{
    <link rel="stylesheet" href="~/css/Auth/login.css" />
}

<section class="login">
    <div class="contenedor-login">
        <h1>Acceso Bibliotecario</h1>
        <p>Ingresa con tus credenciales de administrador.</p>

        <form method="post">
            <div class="campo">
                <label>Correo</label>
                <input type="text" name="correo" placeholder="correo@biblioteca.com">
            </div>

            <div class="campo">
                <label>Contraseña</label>
                <input type="password" name="contrasena" placeholder="Ingresa tu contraseña">
            </div>

            @if (Model.ErrorMessage != null)
            {
                <p style="color:red;">@Model.ErrorMessage</p>
            }

            <button type="submit" class="btn-login">Entrar</button>
        </form>
    </div>
</section>